@* World-space HP display above enemies. Attached via WorldPanel. *@
@namespace Sandbox.UI
@inherits PanelComponent

<root>
    @if ( Enemy.IsValid() )
    {
        <div class="hp-number">@((int)Enemy.CurrentHealth)</div>
    }
</root>

<style>
    EnemyHpPanel {
        font-size: 64px;
        font-weight: bold;
        color: #ff4444;
        text-shadow: 3px 3px 0px #000;
        font-family: Arial, sans-serif;
        text-align: center;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: visible;
    }
    .hp-number {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }
</style>

@code {
    [Property] public Enemy Enemy { get; set; }

    protected override int BuildHash()
    {
        return Enemy.IsValid() ? (int)Enemy.CurrentHealth : 0;
    }
}

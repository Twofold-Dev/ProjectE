@* Upgrade selection panel — per-player upgrade choices side by side. *@
@namespace Sandbox.UI
@inherits PanelComponent

<root>
    @if ( IsVisible )
    {
        <div class="upgrade-overlay">
            <div class="upgrade-players">
                @for ( int i = 0; i < AllManagers.Count; i++ )
                {
                    var um = AllManagers[i];
                    var isOwner = um.Network.IsOwner;
                    <div class="upgrade-player-side">
                        <div class="upgrade-section-title">Choose your upgrade</div>
                        <div class="upgrade-player-name @(isOwner ? "owner" : "")">
                            Player @(i + 1) @(isOwner ? "(You)" : "")
                        </div>
                        @if ( !um.HasSelected )
                        {
                            <div class="upgrade-choices">
                                @foreach ( var option in (um.CurrentOptions ?? new()) )
                                {
                                    <div class="upgrade-card @(isOwner ? "clickable" : "")"
                                         @onclick="@(isOwner ? () => um.SelectUpgrade(option) : null)">
                                        <div class="upgrade-name">@GetName(option)</div>
                                        <div class="upgrade-level">Lv @GetLevel(um, option) → @(GetLevel(um, option) + 1)</div>
                                        <div class="upgrade-desc">@GetDesc(option)</div>
                                    </div>
                                }
                            </div>
                            @if ( um.CurrentOptions.Count == 0 )
                            {
                                <div class="upgrade-status">All upgrades maxed!</div>
                            }
                        }
                        else
                        {
                            var selectedName = um.LastSelected.HasValue ? GetName(um.LastSelected.Value) : "Ready!";
                            var selectedLevel = um.LastSelected.HasValue ? um.CurrentUpgrades?.GetLevel(um.LastSelected.Value) ?? 0 : 0;
                            <div class="upgrade-chosen">
                                <div class="upgrade-chosen-label">Chosen</div>
                                <div class="upgrade-chosen-name">@selectedName</div>
                                <div class="upgrade-chosen-level">Level @selectedLevel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</root>

<style>
    UpgradePanel {
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
    }
    .upgrade-overlay {
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #000000b3;
        pointer-events: all;
    }
    .upgrade-players {
        display: flex;
        flex-direction: row;
        width: 100%;
        height: 100%;
    }
    .upgrade-player-side {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        width: 50%;
        height: 100%;
    }
    .upgrade-section-title {
        font-size: 42px;
        color: white;
        font-weight: bold;
        text-shadow: 2px 2px 4px #000000cc;
    }
    .upgrade-player-name {
        font-size: 22px;
        color: #88ddff;
        font-weight: bold;
    }
    .upgrade-player-name.owner {
        color: #ffdd88;
    }
    .upgrade-choices {
        display: flex;
        flex-direction: row;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .upgrade-card {
        width: 200px;
        height: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 12px;
        border: 2px solid #4a4a6e;
        border-radius: 12px;
        background: linear-gradient(145deg, #2a2a3e, #1a1a2e);
    }
    .upgrade-card.clickable {
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .upgrade-card.clickable:hover {
        border-color: #8888ff;
        transform: scale(1.05);
        background: linear-gradient(145deg, #3a3a5e, #2a2a4e);
    }
    .upgrade-name {
        font-size: 18px;
        color: #aaccff;
        font-weight: bold;
        margin-bottom: 4px;
    }
    .upgrade-level {
        font-size: 13px;
        color: #88aacc;
        margin-bottom: 3px;
    }
    .upgrade-desc {
        font-size: 12px;
        color: #ccccee;
        text-align: center;
    }
    .upgrade-status { font-size: 18px; color: #ffaa44; }
    .upgrade-chosen { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .upgrade-chosen-label { font-size: 14px; color: #88aacc; }
    .upgrade-chosen-name { font-size: 24px; color: #44ff88; font-weight: bold; }
    .upgrade-chosen-level { font-size: 16px; color: #88dd88; }
</style>

@code {
    private GameManager _gm;
    private List<UpgradeManager> AllManagers = new();
    public bool IsVisible { get; set; } = false;

    protected override void OnUpdate()
    {
        if ( _gm == null ) _gm = Scene.GetAllComponents<GameManager>().FirstOrDefault();

        var shouldShow = _gm != null && _gm.State == GameManager.GameState.UpgradeSelect;
        if ( IsVisible != shouldShow )
        {
            IsVisible = shouldShow;
        }

        AllManagers.Clear();
        if ( shouldShow )
        {
            foreach ( var um in Scene.GetAllComponents<UpgradeManager>() )
            {
                if ( um.CurrentOptions.Count == 0 && !um.HasSelected )
                    um.OfferUpgrades();
                AllManagers.Add( um );
            }
        }
    }

    private string GetName( UpgradeType t ) => t switch
    {
        UpgradeType.ArrowFrequency => "Coffee Rush",
        UpgradeType.ArrowDamage => "Stapler Power",
        UpgradeType.ArrowSpeed => "Aerodynamics",
        UpgradeType.ArrowDistance => "Paper Stream",
        UpgradeType.SwordCount => "Extra Shredders",
        UpgradeType.SwordDamage => "Sharp Blades",
        UpgradeType.PetCount => "Desk Buddies",
        UpgradeType.PetFireRate => "Busy Buddies",
        UpgradeType.MovementSpeed => "Office Chair",
        UpgradeType.HealthBoost => "Sick Days",
        _ => t.ToString(),
    };

    private string GetDesc( UpgradeType t ) => t switch
    {
        UpgradeType.ArrowFrequency => "+0.3 shots/sec",
        UpgradeType.ArrowDamage => "+5 damage per hit",
        UpgradeType.ArrowSpeed => "+100 speed",
        UpgradeType.ArrowDistance => "+200 range",
        UpgradeType.SwordCount => "+1 orbiting shredder",
        UpgradeType.SwordDamage => "+8 shredder damage",
        UpgradeType.PetCount => "+1 desk buddy",
        UpgradeType.PetFireRate => "+0.5 buddy attacks/sec",
        UpgradeType.MovementSpeed => "+50 move speed",
        UpgradeType.HealthBoost => "+20 HP, heal",
        _ => "",
    };

    private int GetLevel( UpgradeManager um, UpgradeType t ) => um.CurrentUpgrades?.GetLevel( t ) ?? 0;

    protected override int BuildHash()
    {
        return System.HashCode.Combine( IsVisible, AllManagers.Count );
    }
}

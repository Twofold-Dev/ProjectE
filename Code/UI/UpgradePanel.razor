@* Upgrade selection panel — per-player upgrade choices side by side. *@
@namespace Sandbox.UI
@inherits PanelComponent

<root>
    @if ( IsVisible )
    {
        @if ( ShowPlaystyleSelect )
        {
            <div class="upgrade-overlay">
                <div class="upgrade-title">Choose Your Weapon</div>
                <div class="upgrade-players">
                    @foreach ( var um in AllManagers )
                    {
                        var capturedUm = um;
                        var isMine = IsLocalPlayer( capturedUm );
                        var side = isMine ? "right" : "left";
                        <div class="upgrade-player-side @side">
                            <div class="upgrade-player-name @side">@GetPlayerName(capturedUm)</div>
                            @if ( !capturedUm.HasSelected )
                            {
                                <div class="upgrade-choices">
                                    @foreach ( var ps in playstyles )
                                    {
                                        var capturedPs = ps;
                                        <div class="@(isMine ? "upgrade-card clickable" : "upgrade-card disabled")"
                                             @onclick="@(() => OnPlaystyleClicked(capturedUm, capturedPs))">
                                            <div class="upgrade-name">@GetPlaystyleName(capturedPs)</div>
                                            <div class="upgrade-desc">@GetPlaystyleDesc(capturedPs)</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="upgrade-chosen">
                                    <div class="upgrade-chosen-name">@GetPlaystyleName(capturedUm.CurrentUpgrades.ChosenPlaystyle)</div>
                                </div>
                            }
                            @if ( !isMine && !capturedUm.HasSelected )
                            {
                                <div class="waiting-text">Waiting for @GetPlayerName(capturedUm)...</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="upgrade-overlay">
                <div class="upgrade-title">Choose an Upgrade</div>
                <div class="upgrade-players">
                    @foreach ( var um in AllManagers )
                    {
                        var capturedUm = um;
                        var isMine = IsLocalPlayer( capturedUm );
                        var side = isMine ? "right" : "left";
                        <div class="upgrade-player-side @side">
                            <div class="upgrade-player-name @side">@GetPlayerName(capturedUm)</div>
                            @if ( !capturedUm.HasSelected )
                            {
                                <div class="upgrade-choices">
                                    @foreach ( var option in (capturedUm.CurrentOptions ?? new()) )
                                    {
                                        var capturedOption = option;
                                        <div class="@(isMine ? "upgrade-card clickable" : "upgrade-card disabled")"
                                             @onclick="@(() => OnUpgradeClicked(capturedUm, capturedOption))">
                                            <div class="upgrade-name">@GetName(capturedOption)</div>
                                            <div class="upgrade-level">Lv @GetLevel(capturedUm, capturedOption) → @(GetLevel(capturedUm, capturedOption) + 1)</div>
                                            <div class="upgrade-desc">@GetDesc(capturedOption)</div>
                                        </div>
                                    }
                                </div>
                                @if ( capturedUm.CurrentOptions.Count == 0 )
                                {
                                    <div class="upgrade-status">All upgrades maxed!</div>
                                }
                            }
                            else
                            {
                                <div class="upgrade-chosen">
                                    <div class="upgrade-chosen-label">Chosen</div>
                                    <div class="upgrade-chosen-name">@GetName(capturedUm.LastSelected ?? UpgradeType.ArrowFrequency)</div>
                                </div>
                            }
                            @if ( !isMine && !capturedUm.HasSelected )
                            {
                                <div class="waiting-text">Waiting for @GetPlayerName(capturedUm)...</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</root>

<style>
    UpgradePanel {
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
    }
    .upgrade-overlay {
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #000000b3;
        pointer-events: all;
    }
    .upgrade-players {
        display: flex;
        flex-direction: row;
        width: 100%;
        height: 100%;
    }
    .upgrade-player-side {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        width: 50%;
        height: 100%;
    }
    .upgrade-player-side.left { align-items: flex-start; padding-left: 40px; }
    .upgrade-player-side.right { align-items: flex-end; padding-right: 40px; }
    .upgrade-player-name { font-size: 20px; font-weight: bold; color: #88ddff; margin-bottom: 8px; }
    .upgrade-player-name.left { color: #88ddff; }
    .upgrade-player-name.right { color: #ffdd88; }
    .upgrade-section-title {
        font-size: 42px;
        color: white;
        font-weight: bold;
        text-shadow: 2px 2px 4px #000000cc;
    }
    .upgrade-player-name {
        font-size: 22px;
        color: #88ddff;
        font-weight: bold;
    }
    .upgrade-player-name.owner {
        color: #ffdd88;
    }
    .upgrade-choices {
        display: flex;
        flex-direction: row;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .upgrade-card {
        width: 200px;
        height: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 12px;
        border: 2px solid #4a4a6e;
        border-radius: 12px;
        background: linear-gradient(145deg, #2a2a3e, #1a1a2e);
    }
    .upgrade-card.clickable {
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .upgrade-card.clickable:hover {
        border-color: #8888ff;
        transform: scale(1.05);
        background: linear-gradient(145deg, #3a3a5e, #2a2a4e);
    }
    .upgrade-name {
        font-size: 18px;
        color: #aaccff;
        font-weight: bold;
        margin-bottom: 4px;
    }
    .upgrade-level {
        font-size: 13px;
        color: #88aacc;
        margin-bottom: 3px;
    }
    .upgrade-desc {
        font-size: 12px;
        color: #ccccee;
        text-align: center;
    }
    .upgrade-status { font-size: 18px; color: #ffaa44; }
    .upgrade-chosen { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .upgrade-chosen-label { font-size: 14px; color: #88aacc; }
    .upgrade-chosen-name { font-size: 24px; color: #44ff88; font-weight: bold; }
    .upgrade-chosen-level { font-size: 16px; color: #88dd88; }
</style>

@code {
    private GameManager _gm;
    private List<UpgradeManager> AllManagers = new();

    public bool IsVisible { get; set; } = false;
    public bool ShowPlaystyleSelect => _gm != null && !_gm.PlaystylePhaseComplete;

    private List<Playstyle> playstyles = new() { Playstyle.RapidFire, Playstyle.SplitShot, Playstyle.PowerShot };

    protected override void OnUpdate()
    {
        if ( _gm == null ) _gm = Scene.GetAllComponents<GameManager>().FirstOrDefault();

        var shouldShow = _gm != null && _gm.State == GameManager.GameState.UpgradeSelect;
        if ( IsVisible != shouldShow )
        {
            IsVisible = shouldShow;
            Log.Info( $"UpgradePanel: IsVisible={IsVisible}, State={_gm?.State}" );
        }

        AllManagers.Clear();
        if ( shouldShow )
        {
            foreach ( var um in Scene.GetAllComponents<UpgradeManager>() )
            {
                // Generate options if not yet populated.
                if ( !ShowPlaystyleSelect && um.CurrentOptions.Count == 0 )
                    um.OfferUpgrades();
                AllManagers.Add( um );
            }
        }
    }

    private void OnUpgradeClicked( UpgradeManager um, UpgradeType option )
    {
        if ( !IsLocalPlayer( um ) )
        {
            Log.Info( $"OnUpgradeClicked: not local player, ignoring" );
            return;
        }
        if ( um.HasSelected )
        {
            Log.Info( $"OnUpgradeClicked: already selected, ignoring" );
            return;
        }
        Log.Info( $"Upgrade clicked: um={um.GameObject.Name}, type={option}" );
        um.SelectUpgrade( option );
    }

    private void OnPlaystyleClicked( UpgradeManager um, Playstyle ps )
    {
        if ( !IsLocalPlayer( um ) )
        {
            Log.Info( $"OnPlaystyleClicked: not local player, ignoring" );
            return;
        }
        if ( um.HasSelected )
        {
            Log.Info( $"OnPlaystyleClicked: already selected, ignoring" );
            return;
        }
        Log.Info( $"Playstyle clicked: um={um.GameObject.Name}, style={ps}" );
        um.SelectPlaystyle( ps );
    }

    private string GetPlaystyleName( Playstyle ps ) => ps switch
    {
        Playstyle.RapidFire => "Rapid Fire",
        Playstyle.SplitShot => "Split Shot",
        Playstyle.PowerShot => "Power Shot",
        _ => ps.ToString(),
    };

    private string GetPlayerName( UpgradeManager um )
    {
        var player = um.GetComponent<ArrowPlayer>();
        return player?.GameObject.Name ?? "Player";
    }

    private bool IsLocalPlayer( UpgradeManager um )
    {
        if ( !um.IsValid() ) return false;
        // Use GUID comparison — more reliable than Connection reference identity
        var ownerId = um.Network.Owner?.Id;
        return ownerId.HasValue && ownerId.Value == Connection.Local?.Id;
    }

    private string GetPlaystyleDesc( Playstyle ps ) => ps switch
    {
        Playstyle.RapidFire => "Fire rate: 3/s\nDamage: 6 each\nDPS: 18 — consistent chip",
        Playstyle.SplitShot => "Fire rate: 1.5/s\n3 pens × 7 dmg = 21/volley\nSpread damage, good for groups",
        Playstyle.PowerShot => "Fire rate: 0.6/s\nDamage: 30 each\nDPS: 18 — heavy single-target",
        _ => "",
    };

    private string GetName( UpgradeType t ) => t switch
    {
        UpgradeType.ArrowFrequency => "Fire Rate",
        UpgradeType.ArrowDamage => "Damage",
        UpgradeType.ArrowSpeed => "Proj Speed",
        UpgradeType.ArrowDistance => "Range",
        UpgradeType.SwordCount => "Scissors",
        UpgradeType.SwordDamage => "Scissor Dmg",
        UpgradeType.PetCount => "Pets",
        UpgradeType.PetFireRate => "Pet Rate",
        UpgradeType.SwordFrequency => "Burst Spd",
        UpgradeType.SwordRange => "Scissor Rng",
        UpgradeType.SplitCount => "Split",
        UpgradeType.CritChance => "Crit Chance",
        UpgradeType.PenPierce => "Piercing",
        UpgradeType.BladeBounce => "Scissors Bounce",
        UpgradeType.HealthBoost => "Health",
        _ => t.ToString(),
    };

    private string GetDesc( UpgradeType t ) => t switch
    {
        UpgradeType.ArrowFrequency => "+0.15 pens/sec",
        UpgradeType.ArrowDamage => "+3 dmg per pen",
        UpgradeType.ArrowSpeed => "+100 proj speed",
        UpgradeType.ArrowDistance => "+100 range",
        UpgradeType.SwordCount => "+1 Scissors",
        UpgradeType.SwordDamage => "+5 Scissor dmg",
        UpgradeType.PetCount => "+1 pet companion",
        UpgradeType.PetFireRate => "+0.5 pet atk/sec",
        UpgradeType.SwordFrequency => "+1 burst speed",
        UpgradeType.SwordRange => "+1 scissor range",
        UpgradeType.SplitCount => "+1 pen split",
        UpgradeType.CritChance => "+10% crit chance",
        UpgradeType.PenPierce => "+1 enemy pierce",
        UpgradeType.BladeBounce => "+1 scissors bounce",
        UpgradeType.HealthBoost => "+20 HP + heal",
        _ => "",
    };

    private int GetLevel( UpgradeManager um, UpgradeType t ) => um.CurrentUpgrades?.GetLevel( t ) ?? 0;

    protected override int BuildHash()
    {
        var gm = Scene.GetAllComponents<GameManager>().FirstOrDefault();
        int hash = 17;
        hash = hash * 31 + IsVisible.GetHashCode();
        hash = hash * 31 + AllManagers.Count;
        hash = hash * 31 + (gm?.State ?? GameManager.GameState.Lobby).GetHashCode();
        hash = hash * 31 + ShowPlaystyleSelect.GetHashCode();

        foreach ( var um in AllManagers )
        {
            hash = hash * 31 + um.HasSelected.GetHashCode();
            hash = hash * 31 + um.PlaystyleSelected.GetHashCode();
            hash = hash * 31 + um.CurrentOptions.Count.GetHashCode();
        }

        return hash;
    }
}

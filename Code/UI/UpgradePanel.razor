@* Upgrade selection panel — per-player upgrade choices side by side. *@
@namespace Sandbox.UI
@inherits PanelComponent

<root>
    @if ( IsVisible )
    {
        @if ( ShowPlaystyleSelect )
        {
            <div class="upgrade-overlay">
                <div class="upgrade-title">Choose Your Weapon</div>
                <div class="upgrade-players">
                    @for ( int i = 0; i < AllManagers.Count; i++ )
                    {
                        var um = AllManagers[i];
                        var isOwner = um.Network.IsOwner;
                        var side = i == 0 ? "left" : "right";
                        <div class="upgrade-player-side @side">
                            <div class="upgrade-player-name @(isOwner ? "owner" : "")">
                                Player @(i + 1) @(isOwner ? "(You)" : "")
                            </div>
                            @if ( !um.HasSelected )
                            {
                                <div class="upgrade-choices">
                                    @foreach ( var ps in playstyles )
                                    {
                                        <div class="upgrade-card clickable"
                                             @onclick="@(isOwner ? () => SelectPlaystyle(um, ps) : null)">
                                            <div class="upgrade-name">@GetPlaystyleName(ps)</div>
                                            <div class="upgrade-desc">@GetPlaystyleDesc(ps)</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="upgrade-chosen">
                                    <div class="upgrade-chosen-name">@GetPlaystyleName(um.CurrentUpgrades.ChosenPlaystyle)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="upgrade-overlay">
                <div class="upgrade-title">Choose an Upgrade</div>
                <div class="upgrade-players">
                    @for ( int i = 0; i < AllManagers.Count; i++ )
                    {
                        var um = AllManagers[i];
                        var isOwner = um.Network.IsOwner;
                        var side = i == 0 ? "left" : "right";
                        <div class="upgrade-player-side @side">
                            <div class="upgrade-player-name @(isOwner ? "owner" : "")">
                                Player @(i + 1) @(isOwner ? "(You)" : "")
                            </div>
                            @if ( !um.HasSelected )
                            {
                                <div class="upgrade-choices">
                                    @foreach ( var option in (um.CurrentOptions ?? new()) )
                                    {
                                        <div class="upgrade-card @(isOwner ? "clickable" : "")"
                                             @onclick="@(isOwner ? () => um.SelectUpgrade(option) : null)">
                                            <div class="upgrade-name">@GetName(option)</div>
                                            <div class="upgrade-level">Lv @GetLevel(um, option) → @(GetLevel(um, option) + 1)</div>
                                            <div class="upgrade-desc">@GetDesc(option)</div>
                                        </div>
                                    }
                                </div>
                                @if ( um.CurrentOptions.Count == 0 )
                                {
                                    <div class="upgrade-status">All upgrades maxed!</div>
                                }
                            }
                            else
                            {
                                <div class="upgrade-chosen">
                                    <div class="upgrade-chosen-label">Chosen</div>
                                    <div class="upgrade-chosen-name">@GetName(um.LastSelected ?? UpgradeType.ArrowFrequency)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</root>

<style>
    UpgradePanel {
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
    }
    .upgrade-overlay {
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #000000b3;
        pointer-events: all;
    }
    .upgrade-players {
        display: flex;
        flex-direction: row;
        width: 100%;
        height: 100%;
    }
    .upgrade-player-side {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        width: 50%;
        height: 100%;
    }
    .upgrade-section-title {
        font-size: 42px;
        color: white;
        font-weight: bold;
        text-shadow: 2px 2px 4px #000000cc;
    }
    .upgrade-player-name {
        font-size: 22px;
        color: #88ddff;
        font-weight: bold;
    }
    .upgrade-player-name.owner {
        color: #ffdd88;
    }
    .upgrade-choices {
        display: flex;
        flex-direction: row;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .upgrade-card {
        width: 200px;
        height: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 12px;
        border: 2px solid #4a4a6e;
        border-radius: 12px;
        background: linear-gradient(145deg, #2a2a3e, #1a1a2e);
    }
    .upgrade-card.clickable {
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .upgrade-card.clickable:hover {
        border-color: #8888ff;
        transform: scale(1.05);
        background: linear-gradient(145deg, #3a3a5e, #2a2a4e);
    }
    .upgrade-name {
        font-size: 18px;
        color: #aaccff;
        font-weight: bold;
        margin-bottom: 4px;
    }
    .upgrade-level {
        font-size: 13px;
        color: #88aacc;
        margin-bottom: 3px;
    }
    .upgrade-desc {
        font-size: 12px;
        color: #ccccee;
        text-align: center;
    }
    .upgrade-status { font-size: 18px; color: #ffaa44; }
    .upgrade-chosen { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .upgrade-chosen-label { font-size: 14px; color: #88aacc; }
    .upgrade-chosen-name { font-size: 24px; color: #44ff88; font-weight: bold; }
    .upgrade-chosen-level { font-size: 16px; color: #88dd88; }
</style>

@code {
    private GameManager _gm;
    private List<UpgradeManager> AllManagers = new();
    public bool IsVisible { get; set; } = false;
    public bool ShowPlaystyleSelect => _gm != null && !_gm.PlaystyleChosen;

    private List<Playstyle> playstyles = new() { Playstyle.RapidFire, Playstyle.SplitShot, Playstyle.PowerShot };

    protected override void OnUpdate()
    {
        if ( _gm == null ) _gm = Scene.GetAllComponents<GameManager>().FirstOrDefault();

        var shouldShow = _gm != null && _gm.State == GameManager.GameState.UpgradeSelect;
        if ( IsVisible != shouldShow )
        {
            IsVisible = shouldShow;
        }

        AllManagers.Clear();
        if ( shouldShow )
        {
            foreach ( var um in Scene.GetAllComponents<UpgradeManager>() )
            {
                if ( !ShowPlaystyleSelect && um.CurrentOptions.Count == 0 && !um.HasSelected )
                    um.OfferUpgrades();
                AllManagers.Add( um );
            }
        }
    }

    private void SelectPlaystyle( UpgradeManager um, Playstyle ps )
    {
        um.CurrentUpgrades.ChosenPlaystyle = ps;
        um.CurrentUpgrades.PlaystyleLocked = true;
        um.HasSelected = true;
        _gm.PlaystyleChosen = true;

        if ( Networking.IsHost )
        {
            bool allReady = true;
            foreach ( var u in Scene.GetAllComponents<UpgradeManager>() )
                if ( !u.HasSelected ) { allReady = false; break; }
            if ( allReady )
                _gm.OnAllPlayersReady();
        }
    }

    private string GetPlaystyleName( Playstyle ps ) => ps switch
    {
        Playstyle.RapidFire => "Rapid Fire",
        Playstyle.SplitShot => "Split Shot",
        Playstyle.PowerShot => "Power Shot",
        _ => ps.ToString(),
    };

    private string GetPlaystyleDesc( Playstyle ps ) => ps switch
    {
        Playstyle.RapidFire => "Spam throw pens!\n3 pens/sec\nLow damage each",
        Playstyle.SplitShot => "Pen split!\n3 pens per throw\nScreen coverage",
        Playstyle.PowerShot => "Heavy pen toss!\n1 pen every 2s\nMassive damage",
        _ => "",
    };

    private string GetName( UpgradeType t ) => t switch
    {
        UpgradeType.ArrowFrequency => "Fire Rate",
        UpgradeType.ArrowDamage => "Damage",
        UpgradeType.ArrowSpeed => "Proj Speed",
        UpgradeType.ArrowDistance => "Range",
        UpgradeType.SwordCount => "Scissors",
        UpgradeType.SwordDamage => "Scissor Dmg",
        UpgradeType.PetCount => "Pets",
        UpgradeType.PetFireRate => "Pet Rate",
        UpgradeType.SwordFrequency => "Burst Spd",
        UpgradeType.SwordRange => "Scissor Rng",
        UpgradeType.SplitCount => "Pen +X",
        UpgradeType.PenBounce => "Bouncing Pens",
        UpgradeType.PenPierce => "Piercing Pens",
        UpgradeType.BladeBounce => "Blade Bounce",
        UpgradeType.HealthBoost => "Health",
        _ => t.ToString(),
    };

    private string GetDesc( UpgradeType t ) => t switch
    {
        UpgradeType.ArrowFrequency => "+0.3 pens/sec",
        UpgradeType.ArrowDamage => "+5 damage per pen",
        UpgradeType.ArrowSpeed => "+100 proj speed",
        UpgradeType.ArrowDistance => "+200 range",
        UpgradeType.SwordCount => "+1 scissor blade",
        UpgradeType.SwordDamage => "+8 scissor damage",
        UpgradeType.PetCount => "+1 pet companion",
        UpgradeType.PetFireRate => "+0.5 pet attacks/sec",
        UpgradeType.SwordFrequency => "+1 cd down",
        UpgradeType.SwordRange => "+1 scissor range",
        UpgradeType.SplitCount => "+1 pen split",
        UpgradeType.PenBounce => "+1 wall bounce",
        UpgradeType.PenPierce => "+1 enemy pierce",
        UpgradeType.BladeBounce => "+1 blade bounce",
        UpgradeType.HealthBoost => "+20 HP, heal",
        _ => "",
    };

    private int GetLevel( UpgradeManager um, UpgradeType t ) => um.CurrentUpgrades?.GetLevel( t ) ?? 0;

    protected override int BuildHash()
    {
        return System.HashCode.Combine( IsVisible, AllManagers.Count );
    }
}

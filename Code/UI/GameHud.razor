@* Main HUD for Arrow a Row. *@
@namespace Sandbox.UI
@inherits PanelComponent

<root>
    <div class="hud-root">
        <div class="hud-top">
            <div class="health-bar-wrap">
                <div class="health-bar-fill" style="width: @HealthPercent%"></div>
                <div class="health-label">@HealthCurrent / @HealthMax</div>
            </div>
            <div class="wave-display">Wave @Wave</div>
            <div class="score-display">Score: @Score</div>
        </div>
        <div class="stats-container">
            @foreach ( var entry in AllPlayerStats )
            {
                <div class="stats-panel @entry.Side">
                    <div class="stats-title">@entry.Name</div>
                    <div class="stat-row">Fire Rate: @entry.FireRate</div>
                    <div class="stat-row">Damage: @entry.Damage</div>
                    <div class="stat-row">Speed: @entry.Speed</div>
                    <div class="stat-row">Range: @entry.Range</div>
                    <div class="stat-row">Pens: @entry.SplitCount</div>
                    <div class="stat-row">Scissors: @entry.ShredderCount | @entry.ShredderDamage dmg | Rng @entry.ShredderRange</div>
                    <div class="stat-row">Bounce: @entry.PenBounce | Pierce: @entry.PenPierce | BladeBn: @entry.BladeBounce</div>
                </div>
            }
        </div>
    </div>
</root>

<style>
    GameHud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; }
    .hud-root { width: 100%; height: 100%; display: flex; flex-direction: column; }
    .hud-top { position: absolute; top: 0; left: 0; right: 0; display: flex; flex-direction: row; justify-content: space-between; align-items: flex-start; padding: 20px; }
    .score-display { font-size: 28px; color: white; font-weight: bold; text-shadow: 2px 2px 4px #000000cc; }
    .wave-display { position: absolute; left: 50%; transform: translateX(-50%); top: 20px; font-size: 24px; color: #ffcc44; font-weight: bold; text-shadow: 2px 2px 4px #000000cc; }
    .health-bar-wrap { width: 300px; height: 32px; background: #000000b0; border: 3px solid #888; border-radius: 6px; position: relative; }
    .health-bar-fill { height: 100%; background: linear-gradient(90deg, #33cc33, #66ff66); border-radius: 4px; transition: width 0.3s ease; }
    .health-label { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 20px; color: white; font-weight: bold; text-shadow: 2px 2px 3px #000; }
    .stats-container { position: absolute; bottom: 20px; left: 0; right: 0; display: flex; flex-direction: row; justify-content: space-between; padding: 0 20px; }
    .stats-panel { background: #00000080; border-radius: 8px; padding: 8px 16px; display: flex; flex-direction: column; gap: 2px; }
    .stats-title { font-size: 14px; color: #88ddff; font-weight: bold; margin-bottom: 4px; }
    .stat-row { font-size: 16px; color: #ccddee; font-weight: bold; text-shadow: 1px 1px 2px #000000cc; white-space: nowrap; }
</style>

@code {
    private GameManager _gm;
    private ArrowPlayer _player;
    private List<PlayerStatEntry> AllPlayerStats = new();

    public int Score => _gm?.TotalScore ?? 0;
    public int Wave => _gm?.CurrentWave ?? 0;
    public float HealthCurrent => _player?.Health ?? 100;
    public float HealthMax => _player?.MaxHealth ?? 100;
    public float HealthPercent => HealthMax > 0 ? (HealthCurrent / HealthMax * 100f) : 0;

    protected override void OnUpdate()
    {
        if ( _gm == null )
            _gm = Scene.GetAllComponents<GameManager>().FirstOrDefault();
        if ( _player == null )
            _player = GetLocalPlayer();

        RefreshStats();
        StateHasChanged();
    }

    private void RefreshStats()
    {
        AllPlayerStats.Clear();
        int idx = 0;
        foreach ( var p in Scene.GetAllComponents<ArrowPlayer>() )
        {
            AllPlayerStats.Add( new PlayerStatEntry
            {
                Name = $"Player {idx + 1}",
                Side = idx == 0 ? "left" : "right",
                FireRate = $"{p.EffectiveFireRate:F1}/s",
                Damage = $"{(int)p.EffectiveDamage}",
                Speed = $"{(int)p.EffectiveSpeed}",
                Range = $"{(int)p.EffectiveRange}",
                SplitCount = $"{p.EffectiveSplitCount}",
                ShredderCount = $"{p.GetShredderCount()}",
                ShredderDamage = $"{(int)p.GetShredderDamage()}",
                ShredderRange = $"{p.GetShredderRange()}",
                PenBounce = $"{p.GetPenBounce()}",
                PenPierce = $"{p.GetPenPierce()}",
                BladeBounce = $"{p.GetBladeBounce()}",
            } );
            idx++;
        }
    }

    private ArrowPlayer GetLocalPlayer()
    {
        foreach ( var p in Scene.GetAllComponents<ArrowPlayer>() )
            if ( p.Network.IsOwner ) return p;
        return null;
    }

    protected override int BuildHash()
    {
        // Derive hash from actual displayed values so any stat change triggers re-render
        int hash = 17;
        foreach ( var p in Scene.GetAllComponents<ArrowPlayer>() )
        {
            hash = hash * 31 + p.EffectiveFireRate.GetHashCode();
            hash = hash * 31 + p.EffectiveDamage.GetHashCode();
            hash = hash * 31 + p.EffectiveSpeed.GetHashCode();
            hash = hash * 31 + p.EffectiveRange.GetHashCode();
            hash = hash * 31 + p.EffectiveSplitCount.GetHashCode();
            hash = hash * 31 + p.GetShredderCount().GetHashCode();
            hash = hash * 31 + p.GetShredderDamage().GetHashCode();
            hash = hash * 31 + p.GetShredderRange().GetHashCode();
            hash = hash * 31 + p.GetPenBounce().GetHashCode();
            hash = hash * 31 + p.GetPenPierce().GetHashCode();
            hash = hash * 31 + p.GetBladeBounce().GetHashCode();
            hash = hash * 31 + p.Health.GetHashCode();
            hash = hash * 31 + p.MaxHealth.GetHashCode();
        }
        hash = hash * 31 + Score;
        hash = hash * 31 + Wave;
        return hash;
    }

    public class PlayerStatEntry
    {
        public string Name { get; set; }
        public string Side { get; set; }
        public string FireRate { get; set; }
        public string Damage { get; set; }
        public string Speed { get; set; }
        public string Range { get; set; }
        public string SplitCount { get; set; }
        public string ShredderCount { get; set; }
        public string ShredderDamage { get; set; }
        public string ShredderRange { get; set; }
        public string PenBounce { get; set; }
        public string PenPierce { get; set; }
        public string BladeBounce { get; set; }
    }
}

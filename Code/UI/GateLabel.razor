@* Label floating above upgrade gates. *@
@namespace Sandbox.UI
@inherits PanelComponent

<root>
    <div class="label-text">@Text</div>
</root>

<style>
    GateLabel {
        font-size: 64px;
        font-weight: bold;
        color: #ffffff;
        text-shadow: 3px 3px 0px #000;
        font-family: Arial, sans-serif;
        text-align: center;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: visible;
    }
    .label-text {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        white-space: pre-line;
        text-align: center;
    }
</style>

@code {
    [Property] public string Text { get; set; } = "";

    protected override int BuildHash()
    {
        return Text.GetHashCode();
    }
}

@* Lobby screen — players can ready up before starting the game. *@
@namespace Sandbox.UI
@inherits PanelComponent

<root>
    <div class="lobby-root">
        <div class="lobby-title">Project E</div>
        <div class="lobby-subtitle">Office Clearance Simulator</div>

        <div class="lobby-players">
            <div class="lobby-player @(IsReady ? "ready" : "")">
                <div class="lobby-player-color" style="background: #4488ff"></div>
                <div class="lobby-player-name">You</div>
                <div class="lobby-player-status">@(IsReady ? "Ready!" : "Press Ready")</div>
            </div>
        </div>

        <div class="lobby-button" @onclick="OnToggleReady">
            @(IsReady ? "Waiting..." : "Ready Up")
        </div>
    </div>
</root>

<style>
    LobbyPanel {
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
        pointer-events: all;
    }
    .lobby-root {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1a1a2e, #2a2a3e);
        gap: 24px;
    }
    .lobby-title {
        font-size: 64px;
        color: #88ddff;
        font-weight: bold;
        text-shadow: 3px 3px 0px #000;
    }
    .lobby-subtitle {
        font-size: 20px;
        color: #aaccee;
        margin-bottom: 16px;
    }
    .lobby-players {
        display: flex;
        flex-direction: row;
        gap: 20px;
    }
    .lobby-player {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 20px 32px;
        background: #00000060;
        border: 2px solid #4a4a6e;
        border-radius: 12px;
        min-width: 180px;
        transition: all 0.3s ease;
    }
    .lobby-player.ready {
        border-color: #44cc44;
        background: #00440060;
    }
    .lobby-player-color {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid white;
    }
    .lobby-player-name {
        font-size: 22px;
        color: white;
        font-weight: bold;
    }
    .lobby-player-status {
        font-size: 16px;
        color: #8888aa;
    }
    .lobby-player.ready .lobby-player-status {
        color: #44ff44;
    }
    .lobby-button {
        padding: 12px 48px;
        font-size: 24px;
        color: white;
        font-weight: bold;
        background: linear-gradient(145deg, #3366aa, #224488);
        border: 2px solid #4488cc;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 16px;
    }
    .lobby-button:hover {
        transform: scale(1.05);
        background: linear-gradient(145deg, #4488cc, #3366aa);
    }
</style>

@code {
    private GameManager _gm;
    public bool IsReady => _gm?.IsReady ?? false;

    protected override void OnUpdate()
    {
        if ( _gm == null )
            _gm = Scene.GetAllComponents<GameManager>().FirstOrDefault();
    }

    private void OnToggleReady()
    {
        _gm?.ToggleReady();
    }

    protected override int BuildHash()
    {
        return IsReady.GetHashCode();
    }
}
